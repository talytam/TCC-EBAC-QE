{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "@wdio/globals/types"
    ],
    "skipLibCheck": true
  },
  "include": [
    "wdio.conf.ts",
    "test/**/*.ts"
  ]
}
